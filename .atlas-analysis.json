  "keyFeatures": [
    "Event-driven agent framework for annotation workflows",
    "Support for result, task, dataset, and export events",
    "Context-based action system (approve, reject, flag, skip)",
    "Blocking and non-blocking polling modes",
    "Project and task type filtering",
    "Comprehensive error handling with custom exceptions",
    "Environment variable and constructor-based configuration",
    "Built on httpx for reliable HTTP communication"
  ],
  "publicApiSurface": [
    "TaskAgent",
    "TaskAgent.on(event)",
    "TaskAgent.run()",
    "TaskAgent.run_once()",
    "TaskAgent.close()",
    "ResultContext",
    "ResultContext.approve(reason)",
    "ResultContext.reject(reason)",
    "ResultContext.flag(reason)",
    "ResultContext.skip()",
    "TaskContext",
